generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  firstName    String
  lastName     String
  email        String @unique
  passwordHash String

  avatar String?

  phone        String?
  location     String?
  headline     String?
  bio          String?
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?
  skills       String?

  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime?

  emailNotifications Boolean @default(true)
  interviewReminders Boolean @default(true)
  followUpReminders  Boolean @default(true)

  jobs          Job[]
  resumes       Resume[]
  notifications Notification[]

  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Job {
  id        String     @id @default(cuid())
  company   String
  jobTitle  String
  description String?
  location  String?
  jobType   JobType
  workMode  WorkMode
  salaryMin Int?
  salaryMax Int?
  status    JobStatus  @default(WISHLIST)
  source    JobSource?
  jobUrl    String?
  notes     String?

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  aiAnalysis JobAiAnalysis?

  followUpDate DateTime?
  followUpDone Boolean   @default(false)

  appliedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  activities    JobActivity[]
  interviews    Interview[]
  notifications Notification[]

  @@index([userId])
  @@index([status])
  @@index([company])
  @@index([createdAt])
  @@index([resumeId])
  @@map("jobs")
}

model JobActivity {
  id String @id @default(cuid())

  type JobActivityType

  title String

  description String?

  eventDate DateTime

  createdAt DateTime @default(now())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([eventDate])
  @@map("job_activities")
}

model Interview {
  id String @id @default(cuid())

  round String

  scheduledAt DateTime

  interviewerName String?

  meetingLink String?

  notes String?

  completed Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  jobId String

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([scheduledAt])
  @@map("interviews")
}

model Notification {
  id String @id @default(cuid())

  title   String
  message String

  type NotificationType

  isRead Boolean @default(false)

  actionUrl String?

  reminderDate DateTime?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId, type, reminderDate])
  @@index([userId])
  @@index([jobId])
  @@index([createdAt])
}

model Resume {
  id           String  @id @default(cuid())
  originalName String
  storedName   String
  filePath     String
  mimeType     String
  fileSize     Int
  label        String?
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobs Job[]

  aiAnalyses JobAiAnalysis[]

  @@index([userId])
  @@map("resumes")
}

model JobAiAnalysis {
  id String @id @default(cuid())

  matchScore Int

  matchingSkills String[]
  missingSkills  String[]
  suggestions   String[]

  provider String
  model    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobId String @unique
  job   Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([createdAt])
  @@map("job_ai_analyses")
}

enum JobStatus {
  WISHLIST
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  ACCEPTED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum JobSource {
  LINKEDIN
  NAUKRI
  INDEED
  REFERRAL
  COMPANY_WEBSITE
  OTHER
}

enum JobActivityType {
  CREATED
  STATUS_CHANGED
  NOTE
  FOLLOW_UP
  INTERVIEW
  RESUME
  OFFER
  REJECTED
  OTHER
}

enum NotificationType {
  FOLLOW_UP
  INTERVIEW
  JOB_STATUS
  SYSTEM
}
